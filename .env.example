# DhobbyTV Environment Variables
# Copia este archivo a .env.local y llena los valores

# Supabase PostgreSQL Database URL
# Obten esto de tu proyecto Supabase -> Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Gun.js Relay URL (para P2P matchmaking, presencia online, cola de verificacion)
# Despliega un Gun relay gratuito en Render: solo necesita el codigo de mini-services/gun-relay/
# Despues de desplegar, pon la URL aqui (ej: https://tu-gun-relay.onrender.com/gun)
NEXT_PUBLIC_GUN_RELAY=""
