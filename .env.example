# DhobbyTV Environment Variables
# Copia este archivo a .env.local y llena los valores

# Supabase PostgreSQL Database URL
# Obtén esto de tu proyecto Supabase -> Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Socket.io Service URL (para el servicio de matchmaking/WebRTC signaling)
# Este servicio corre separado en Render/Railway/etc
SOCKET_SERVER_URL="https://your-socket-service.onrender.com"
